generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  username String @default("user")
  password String

  sex       String  @default("no male") // "male" | "female", потім зміню мб на enum/аналог
  avatarUrl String? @default("") // пізніше займусь

  createdAt DateTime @default(now())

  gameHistory GameResult[]

  balance Int @default(0)

  lobbiesOwned Lobby[]
  lobbyPlayers LobbyPlayer[]
  gamePlayer   GamePlayer[]
}

model GameSession {
  id       String @id @default(uuid())
  lobbyId  String
  gameType String @default("mafia") // "mafia" | "whoami" | "bunker"

  status String // waiting | night | day | voting | finished
  phase  String // mafia | don | commissar | doctor | discussion | voting | revote_defense etc.

  dayNumber Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings Json @default("{}")
  state    Json @default("{}")
  actions  Json @default("{}")

  players GamePlayer[]

  lobby Lobby @relation(fields: [lobbyId], references: [id])
}

model GameResult {
  id       String @id @default(uuid())
  gameId   String
  userId   String
  gameType String // "mafia" | "bunker" | "whoami"

  result String // "win" | "lose"
  stats  Json   @default("{}")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([gameId])
}

model GamePlayer {
  id String @id @default(uuid())

  gameId String
  userId String

  number Int
  role   String?

  state    Json @default("{}")
  personal Json @default("{}")

  game GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id])

  @@unique([gameId, number])
}

model Lobby {
  id         String  @id @default(uuid())
  name       String
  gameType   String // "mafia" | "whoami" | "bunker"
  maxPlayers Int
  isPrivate  Boolean @default(false)

  status String @default("waiting") // waiting | playing | finished

  // Налаштування для Мафії (залишаємо для зворотної сумісності)
  revealRoles Boolean @default(false)
  lastWords   Boolean @default(true)

  // Універсальні налаштування для кожної гри
  // Для "Хто я?": { wordSource: "players"|"ai", chatMode: "chat"|"nochat", gameMode: "champion"|"loser" }
  settings Json @default("{}")

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  players LobbyPlayer[]

  createdAt DateTime @default(now())

  gameSessions GameSession[]
}

model LobbyPlayer {
  id String @id @default(uuid())

  userId  String
  lobbyId String

  user  User  @relation(fields: [userId], references: [id])
  lobby Lobby @relation(fields: [lobbyId], references: [id])

  isReady  Boolean  @default(false)
  joinedAt DateTime @default(now())
  number   Int      @default(0)

  @@unique([lobbyId, number])
}

model News {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  size        String   // "major" | "minor"
  date        DateTime @default(now())
  
  // Array of sections: Array<{ sectionName: string, subsectionName: string, bullets: string[] }>
  sections    Json     @default("[]")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

